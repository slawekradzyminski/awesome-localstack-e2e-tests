{
  "name": "awesome-localstack-e2e-tests",
  "version": "1.0.0",
  "scripts": {
    "test": "playwright test",
    "test:accounts": "playwright test --grep @accounts",
    "test:admin": "playwright test --grep @admin",
    "test:api": "playwright test --project=api",
    "test:cart": "playwright test --grep @cart",
    "test:catalog": "playwright test --grep @catalog",
    "test:coupons": "playwright test --grep @coupons",
    "test:fast": "playwright test --grep-invert @slow",
    "test:gift-cards": "playwright test --grep @gift-cards",
    "test:graphql": "playwright test --grep @graphql",
    "test:journeys": "playwright test --project=journeys",
    "test:llm": "playwright test --grep @llm",
    "test:loyalty": "playwright test --grep @loyalty",
    "test:orders": "playwright test --grep @orders",
    "test:payments": "playwright test --grep @payments",
    "test:qr": "playwright test --grep @qr",
    "test:search": "playwright test --grep @search",
    "test:security": "playwright test --grep @security",
    "test:smoke": "playwright test --grep @smoke",
    "test:tax": "playwright test --grep \"@tax|@currencies\"",
    "test:tracking": "playwright test --grep @tracking",
    "test:ui": "playwright test --project=ui",
    "test:webhooks": "playwright test --grep @webhooks",
    "check": "npm run typecheck && npm run lint",
    "lint": "eslint . --max-warnings=0",
    "report": "playwright show-report",
    "typecheck": "tsc -p tsconfig.json"
  },
  "keywords": [
    "playwright",
    "e2e",
    "api-testing",
    "typescript",
    "awesome-localstack"
  ],
  "author": "",
  "license": "UNLICENSED",
  "description": "Playwright API, UI and cross-service journey tests for the awesome-localstack commerce features",
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-plugin-playwright": "^2.12.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "private": true
}
